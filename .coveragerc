# What the tests reach. Run with:  python tests/coverage.py
[run]
source =
    agents
    config
    database
    models
    services
    ui
    workflows
# Not app.py: `source` takes module names, and coverage looked
# for a module "app.py" by importing its parent, "app" -- the
# whole page, run at start-up, half-importing numpy so that
# every later import failed (#42).
# Each suite runs in its own process, and some start more
# (the background worker): every Python subprocess is
# measured, each into its own data file, combined after.
patch = subprocess
parallel = True
data_file = .coverage-data/.coverage
concurrency = thread

[report]
skip_empty = True
sort = Cover
precision = 0
exclude_also =
    if __name__ == .__main__.:
    raise NotImplementedError

[html]
directory = coverage-html
